# Centralized API URLs
REACT_APP_LOCAL_API=http://localhost:8080
REACT_APP_LIVE_API=https://elearningbackend.bitecodes.com

# Environment (development | production)
REACT_APP_ENV=development

# Google OAuth Client ID
REACT_APP_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Razorpay Key ID
REACT_APP_RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id

# AI Service Endpoint
REACT_APP_AI_SERVICE_URL=https://ai.bitecodes.com/api/generate
